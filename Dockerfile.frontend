# Frontend Dockerfile
FROM node:18-alpine as builder

# Set working directory
WORKDIR /app

ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_APP_NAME="IEEE Paper Generator"
ARG VITE_MAX_FILE_SIZE=10485760
ARG VITE_ALLOWED_FILE_TYPES=".pdf,.docx"
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_MAX_FILE_SIZE=${VITE_MAX_FILE_SIZE}
ENV VITE_ALLOWED_FILE_TYPES=${VITE_ALLOWED_FILE_TYPES}

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy frontend code
COPY frontend/ .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built app from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy environment template
COPY frontend/.env.example /usr/share/nginx/html/.env.example

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]